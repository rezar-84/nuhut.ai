# Nothing generated lives here; this file exists so the intent is explicit.
.DS_Store
*.DS_Store

# install.py is run in place, so Python leaves bytecode next to it.
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment and sensitive credential files
.env
.env.*
*.env
*.key
*.pem
*.cert
*.pfx
secrets/
*.log

