#!/bin/sh
# Nuhut git hook: refuse a commit whose staged changes add a credential, or change
# a path that the test-lock or protected-path lists name at HEAD.
set -u
here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib.sh"
py=$(hook_find_python) || {
  printf '%s\n' "nuhut: python3 is required to run pre-commit secret guard." >&2
  exit 1
}
eng=$(hook_find_engine "$here") || {
  printf '%s\n' "nuhut: missing .ai-sdlc/bin/hooks.py for pre-commit secret guard." >&2
  exit 1
}
exec "$py" "$eng" git-pre-commit
