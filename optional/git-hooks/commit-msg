#!/bin/sh
# Nuhut git hook: refuse a commit whose message carries no work item ID.
set -u
here=$(cd "$(dirname "$0")" && pwd)
if [ -f "$here/lib.sh" ]; then
  . "$here/lib.sh"
  py=$(hook_find_python) || exit 0
  eng=$(hook_find_engine "$here") || exit 0
else
  py=$(command -v python3 2>/dev/null || command -v python 2>/dev/null) || exit 0
  eng="$here/../bin/hooks.py"
  [ -f "$eng" ] || exit 0
fi
exec "$py" "$eng" git-commit-msg "${1:-}"
